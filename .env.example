# 复制为 .env 并填写（.env 已被 .gitignore 排除，不会提交）
# docker compose 启动时自动读取本文件，注入容器环境变量

# 远程 MySQL（NAS 192.168.1.65:3306/pansou）
PANSOU_MYSQL_HOST=192.168.1.65
PANSOU_MYSQL_PORT=3306
PANSOU_MYSQL_USER=pansou
# 必填：NAS MySQL 密码（cp 后务必改成真实密码，留空会导致 compose 启动报错拦截）
PANSOU_MYSQL_PASSWORD=
PANSOU_MYSQL_DATABASE=pansou

# 应用端口（宿主机映射）
# PORT=3090
